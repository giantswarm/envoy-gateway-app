# Shared infrastructure
# NOTE: AZ / MIN_NODES / MAX_NODES / INSTANCE_TYPE are consumed by the *manual*
# load-testing pipeline (microservices-demo-app/envoy-loadtesting). The e2e
# suite builds its own ephemeral cluster from cluster_values_test.go — keep the
# two in sync when resizing.
WC=envoyloadtesting
MC=graveler
BASE_DOMAIN=gaws2.gigantic.io
AZ=eu-north-1a
MAX_NODES=15
MIN_NODES=10
INSTANCE_TYPE=m5.4xlarge

# Reverse proxy controller to compare against Envoy Gateway. One of: nginx, kong.
# Only the chosen controller's App CR + Helm values are deployed, and the k6
# scenario runs envoy_simulation + the matching <controller>_simulation.
PROXY_CONTROLLER=nginx

# Cluster contexts (kubectl context names)
MC_CONTEXT=teleport.giantswarm.io-graveler                  # Management cluster — WC App CRs applied here
K6_CONTEXT=teleport.giantswarm.io-alba-seu01                # k6 cluster — TestRun + scenario ConfigMap here

# Microservices demo app configuration
# All PUBLIC_ENDPOINTS hostnames fan into a *single* frontend Service in the
# loadtesting namespace, so the whole PEAK_HTTP_RPS budget lands on one set of
# deployments. HPA_MIN_REPLICAS is pre-warmed so the ramp isn't racing HPA's
# ~2min metric+scale lag from a single replica.
PUBLIC_ENDPOINTS=10
HPA_MIN_REPLICAS=20
HPA_MAX_REPLICAS=20

# k6 load testing
#
# Load shape (see test_data/test-scenario.js): the script converts the HTTP
# req/s budget into a k6 iteration rate using the weighted average of 1.684
# HTTP calls per flow, so PEAK_HTTP_RPS=5000 -> 2969 iterations/s.
#
# RAMP_STEP_HTTP_RPS=500 divides the peak into exactly 10 stages
# (500, 1000, ... 5000 HTTP RPS), 90s each = 15min ramp, leaving a 45min hold
# at peak out of the 60min SCENARIO_DURATION_SECONDS. Envoy runs first, then
# WAIT_BETWEEN_SCENARIOS, then the chosen proxy controller:
#   60min (envoy) + 5min (gap) + 60min (nginx) = ~125min wall clock.
#
# PRE_ALLOCATED_VUS/MAX_VUS are cluster-wide totals — k6's execution segments
# divide them across K6_PARALLELISM runners. Little's law at peak:
# 2969 iter/s x ~1.62s average iteration (think time + request latency)
# = ~4800 concurrent VUs, so 5000 pre-allocated with 7500 of headroom.
K6_NAMESPACE=gs-k6-operator
K6_IMAGE=gsoci.azurecr.io/giantswarm/k6:1.6.0
TEST_ID=envoy-load-testing
ENDPOINTS=10
SCENARIO_DURATION_SECONDS=3600
WAIT_BETWEEN_SCENARIOS=300
PEAK_HTTP_RPS=5000
RAMP_STEP_HTTP_RPS=500
RAMP_STEP_DURATION_SECONDS=90
PRE_ALLOCATED_VUS=5000
MAX_VUS=7500
GRACEFUL_STOP=60s

# k6 runner sizing. 8 runners x ~625 VUs / ~625 HTTP RPS each. A throttled load
# generator inflates the latency it is trying to measure, so the runners get
# generous CPU headroom (request 2, burst to 4) rather than requests==limits.
# Budget on the k6 cluster: ~16 CPU / 32Gi requested, ~32 CPU / 64Gi worst case.
K6_PARALLELISM=8
K6_RUNNER_CPU_REQUEST=2
K6_RUNNER_CPU_LIMIT=4
K6_RUNNER_MEMORY_REQUEST=4Gi
K6_RUNNER_MEMORY_LIMIT=8Gi
# The initializer only evaluates the script's init context and the starter only
# POSTs to the runners — both stay small.
K6_HELPER_CPU_REQUEST=200m
K6_HELPER_CPU_LIMIT=1
K6_HELPER_MEMORY_REQUEST=256Mi
K6_HELPER_MEMORY_LIMIT=512Mi

PROMETHEUS_RW_URL=http://mimir-gateway.mimir.svc.cluster.local/api/v1/push
K6_PROMETHEUS_RW_HTTP_HEADERS=X-Scope-OrgID:giantswarm # Must be set to the <key>:<value> format. Multiple headers can be separated by commas, e.g. "Header1:Value1,Header2:Value2"
PROMETHEUS_RW_PUSH_INTERVAL=5s
SLO_P95_LATENCY_MS=500
SLO_P99_LATENCY_MS=1000
SLO_ERROR_RATE=0.001
SLO_CHECKS_RATE=0.95
